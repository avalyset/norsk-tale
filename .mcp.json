{
  "mcpServers": {
    "norsk-tale": {
      "command": "python3",
      "args": [
        "-I",
        "${CLAUDE_PLUGIN_ROOT}/mcp/start.py",
        "--data",
        "${CLAUDE_PLUGIN_DATA}"
      ],
      "env": {
        "NORSK_TALE_VALGT_MODELLVALG": "${user_config.modellvalg}",
        "NORSK_TALE_VALGT_MALFORM": "${user_config.malform}",
        "NORSK_TALE_VALGT_MODELL": "${user_config.modell}",
        "NORSK_TALE_VALGT_WHISPER": "${user_config.whisper}",
        "NORSK_TALE_VALGT_OPPTAK": "${user_config.opptak}"
      }
    }
  }
}
